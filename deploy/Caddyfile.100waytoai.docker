100waytoai.com {
  redir https://www.100waytoai.com{uri} permanent
}

www.100waytoai.com {
  encode gzip zstd

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
  }

  @realtime_asr path /api/asr/realtime
  handle @realtime_asr {
    reverse_proxy baizhi-aliyun-nls-realtime-asr:8787
  }

  @class_audio_records path /api/class-audio-records
  handle @class_audio_records {
    reverse_proxy baizhi-aliyun-nls-realtime-asr:8787
  }

  @class_audio_tasks path /api/class-audio-tasks
  handle @class_audio_tasks {
    reverse_proxy baizhi-aliyun-nls-realtime-asr:8787
  }

  @coze_chat path /api/coze-chat
  handle @coze_chat {
    reverse_proxy baizhi-aliyun-nls-realtime-asr:8787
  }

  @asr path /api/asr /api/asr/
  handle @asr {
    rewrite * /asr
    reverse_proxy baizhi-faster-whisper-asr:8000
  }

  handle {
    root * /srv/baizhi-students
    try_files {path} /index.html
    file_server
  }

  header /index.html Cache-Control "public, max-age=0, must-revalidate"
  header /favicon.svg Cache-Control "public, max-age=86400"
  header /site.webmanifest Cache-Control "public, max-age=86400"
  header /robots.txt Cache-Control "public, max-age=86400"
}
